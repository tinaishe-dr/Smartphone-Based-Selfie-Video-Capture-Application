<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textAlignment="center"
            android:text="Face Capture"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Scan button -->
        <Button
            android:id="@+id/startScanButton"
            android:layout_width="170dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Scan Barcode" />

<!--        <TextView-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:layout_marginTop="20dp"-->
<!--            android:text="Enter subject ID or scan barcode to begin..."-->
<!--            android:textSize="18sp" />-->

        <!-- Barcode scanner area -->
        <FrameLayout
            android:id="@+id/barcodeScannerContainer"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="10dp">

            <!-- Camera preview -->
            <androidx.camera.view.PreviewView
                android:id="@+id/barcodePreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Dark overlay -->
            <View
                android:id="@+id/barcodeOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#66000000" />

            <!-- Scanner box -->
            <FrameLayout
                android:id="@+id/scannerBox"
                android:layout_width="320dp"
                android:layout_height="180dp"
                android:layout_gravity="center">

                <!-- Scanner border -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/scanner_border" />

                <!-- Moving scan line -->
                <View
                    android:id="@+id/scanLine"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_gravity="top"
                    android:background="#00FF00" />

            </FrameLayout>

            <!-- Instruction -->
            <TextView
                android:id="@+id/scanInstruction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal|bottom"
                android:layout_marginBottom="20dp"
                android:text="Place barcode inside the box"
                android:textColor="@android:color/white"
                android:textSize="18sp" />

        </FrameLayout>

        <EditText
            android:id="@+id/subjectIdInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Or Enter Subject ID:"
            android:inputType="text" />

        <Button
            android:id="@+id/continueButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Continue to Selfie Capture" />

        <!-- Storage Information -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_margin="12dp"
            android:background="@drawable/storage_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VIDEO STORAGE"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/storageDirectoryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Storage: Loading..."
                android:textSize="14sp" />

            <TextView
                android:id="@+id/storageSpaceText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Storage space: Loading..."
                android:textSize="14sp" />

            <Button
                android:id="@+id/changeStorageButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Change Directory" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>