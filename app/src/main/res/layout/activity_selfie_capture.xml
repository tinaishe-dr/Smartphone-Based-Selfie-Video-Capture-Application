<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/subjectIdText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Subject: CHILD001"
        android:textSize="20sp"
        android:gravity="center"
        android:padding="10dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.camera.view.PreviewView
            android:id="@+id/selfiePreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:id="@+id/faceGuide"
            android:layout_width="248dp"
            android:layout_height="268dp"
            android:layout_gravity="center"
            android:background="@drawable/face_guide" />

        <TextView
            android:id="@+id/countdownText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="5"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:visibility="gone"
            android:background="#66000000"
            android:padding="20dp" />

    </FrameLayout>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Position your face inside the guide"
        android:textSize="18sp"
        android:gravity="center"
        android:padding="12dp" />

    <Button
        android:id="@+id/startRecordingButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start Recording" />

    <Button
        android:id="@+id/backButton"
        android:layout_gravity="center"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:text="Next Subject" />

    <!-- Storage Information -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_margin="12dp"
        android:background="@drawable/storage_card">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VIDEO STORAGE"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/storageDirectoryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Storage: Loading..."
            android:textSize="14sp" />

        <TextView
            android:id="@+id/storageSpaceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Storage space: Loading..."
            android:textSize="14sp" />

        <Button
            android:id="@+id/changeStorageButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Change Directory" />

    </LinearLayout>

</LinearLayout>